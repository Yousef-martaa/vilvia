APP_NAME=Vilvia
DEBUG=False
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vilvia

# Normal API authentication only needs the project URL. The service-role key
# is required solely when a trusted operator runs
# scripts/fulfill_account_deletions.py. Never expose it to Flutter or commit it.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_TIMEOUT_SECONDS=10.0
# These values must match the maximum Supabase access-token lifetime and the
# verification/deployment clock-skew allowance. Completed-record retention
# must cover the lifetime plus twice the skew (future iat and expired exp
# leeway), or backend startup and purge will fail.
SUPABASE_ACCESS_TOKEN_MAX_LIFETIME_SECONDS=3600
SUPABASE_JWT_CLOCK_SKEW_SECONDS=60
ACCOUNT_DELETION_COMPLETED_RETENTION_DAYS=7

# CORS: exact-match allow-list for real origins (e.g. production/staging web apps).
# JSON array of strings. Empty by default -- no origin is allowed until set.
# Example: CORS_ORIGINS=["https://app.vilvia.com"]
CORS_ORIGINS=[]

# CORS: regex to allow local Flutter Web dev, whose `flutter run -d chrome` uses a
# random localhost port each run. Matches http://localhost:<any port>.
# IMPORTANT: in production, set this to an empty value (CORS_ORIGIN_REGEX=) to
# disable it, unless you specifically intend to allow browser access from localhost
# origins in that environment. Only CORS_ORIGINS should govern production origins.
CORS_ORIGIN_REGEX=^http://localhost:\d+$

# MedlinePlus Web Service (used by scripts/sync_medlineplus.py). Defaults are
# fine for local dev; MEDLINEPLUS_CONTACT_EMAIL is optional but recommended
# for production per MedlinePlus's own usage guidance.
MEDLINEPLUS_BASE_URL=https://wsearch.nlm.nih.gov/ws/query
MEDLINEPLUS_TOOL_NAME=Vilvia
MEDLINEPLUS_CONTACT_EMAIL=
MEDLINEPLUS_TIMEOUT_SECONDS=10.0
MEDLINEPLUS_RETMAX=5

# API rate limiting (see docs/FEATURES/rate_limiting.md). In-memory and
# per-process -- correct for today's single-process deployment only, not
# once Vilvia runs multiple workers/instances (documented there). Defaults
# below match the values chosen for the MVP; RATE_LIMIT_ENABLED=False
# disables all rate limiting outright (e.g. for local load-testing).
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_ME_READ_PER_MINUTE=60
RATE_LIMIT_ME_BOOTSTRAP_PER_MINUTE=10
RATE_LIMIT_ACCOUNT_DELETION_REQUEST_PER_MINUTE=5
RATE_LIMIT_ADMIN_READ_PER_MINUTE=60
RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=20
RATE_LIMIT_COMMUNITY_WRITE_PER_MINUTE=10
