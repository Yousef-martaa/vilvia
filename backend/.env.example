APP_NAME=Vilvia
DEBUG=False
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vilvia

# CORS: exact-match allow-list for real origins (e.g. production/staging web apps).
# JSON array of strings. Empty by default -- no origin is allowed until set.
# Example: CORS_ORIGINS=["https://app.vilvia.com"]
CORS_ORIGINS=[]

# CORS: regex to allow local Flutter Web dev, whose `flutter run -d chrome` uses a
# random localhost port each run. Matches http://localhost:<any port>.
# IMPORTANT: in production, set this to an empty value (CORS_ORIGIN_REGEX=) to
# disable it, unless you specifically intend to allow browser access from localhost
# origins in that environment. Only CORS_ORIGINS should govern production origins.
CORS_ORIGIN_REGEX=^http://localhost:\d+$
