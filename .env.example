# Flutter dev-time config, loaded by dev.sh and passed to `flutter run` as
# --dart-define values (see lib/core/constants/api_constants.dart and
# lib/core/constants/supabase_constants.dart). Copy this file to `.env` and
# fill in your local values. Do not commit `.env`.

# Base URL the Flutter app uses to reach the local FastAPI backend.
# 10.0.2.2 is the Android emulator's alias for the host machine's localhost,
# and is the app's built-in default if this is left unset. Override for
# other targets, e.g. http://127.0.0.1:8000 for web/desktop, or your
# machine's LAN IP for a physical device.
API_BASE_URL=http://10.0.2.2:8000

# Supabase project URL and publishable (anon) key, from your Supabase
# project's API settings. Required -- dev.sh refuses to start Flutter
# without these.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=
